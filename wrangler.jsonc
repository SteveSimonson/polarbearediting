{
  "name": "polarbearediting",
  "main": "workers/site.js",
  "compatibility_date": "2026-07-29",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  // Custom domain routes are intentionally omitted until DNS cutover from Empowery.
  // After approval: add zone routes for polarbearediting.com + www.
  "observability": {
    "enabled": true
  }
}
